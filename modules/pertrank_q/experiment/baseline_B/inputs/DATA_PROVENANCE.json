    "euclidean_score": "Original stored Euclidean score; exactly raw*w0.",
    "query_se_input": "sqrt(original20 unbiased query sample variance/20), conditional on observed control mean; excludes control uncertainty.",
    "wM": "Original fixed PertRank weight.",
    "w0": "Original fixed Euclidean weight.",
    "n_cells": "Original target-cell count, exactly 20 throughout.",
    "profile_energy_I": "Squared original20 mean full-profile norm / G; source squared natural-log units.",
    "profile_energy_M": "Original20 mean profile energy under fixed M=I-beta*U*U.T / G.",
    "control_projection_fraction": "(energy_I-energy_M)/(beta*energy_I); fraction of mean-profile energy in the fixed control subspace.",
    "guide_abs_contrast": "Absolute same20 guide mean query difference; missing single-guide contrast gets deterministic zero fill.",
    "guide_contrast_available": "One iff two guides occur in the original20; distinguishes zero fill from measured agreement.",
    "guide_min_fraction": "Minor observed guide count divided by original20 count; zero for single-guide targets."
  },
